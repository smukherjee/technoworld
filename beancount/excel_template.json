{
  "template_name": "ICICI Bank Statement Excel Template",
  "description": "Template for parsing ICICI bank statement Excel files",
  "version": "1.0",
  
  "file_info": {
    "expected_extensions": [".xls", ".xlsx"],
    "encoding": "utf-8",
    "engine": "xlrd"
  },
  
  "header_detection": {
    "search_rows": [10, 11, 12, 13, 14, 15],
    "header_patterns": [
      "value date",
      "transaction date", 
      "transaction remarks",
      "withdrawal amount",
      "deposit amount",
      "balance"
    ]
  },
  
  "data_mapping": {
    "header_row": null,
    "data_start_row": null,
    "skip_rows": [],
    
    "column_mapping": {
      "date": {
        "possible_names": ["Transaction Date", "Trans Date", "Txn Date"],
        "column_index": null,
        "data_type": "date",
        "date_format": ["%m/%d/%y", "%m/%d/%Y", "%d/%m/%y", "%d/%m/%Y", "%d-%m-%Y", "%Y-%m-%d"]
      },
      "value_date": {
        "possible_names": ["Value Date", "Val Date", "Posting Date"],
        "column_index": null,
        "data_type": "date",
        "date_format": ["%m/%d/%y", "%m/%d/%Y", "%d/%m/%y", "%d/%m/%Y", "%d-%m-%Y", "%Y-%m-%d"]
      },
      "description": {
        "possible_names": ["Transaction Remarks", "Description", "Particulars", "Narration"],
        "column_index": null,
        "data_type": "string",
        "clean_text": true
      },
      "reference": {
        "possible_names": ["Cheque Number", "Chq/Ref Number", "Reference", "Ref No"],
        "column_index": null,
        "data_type": "string",
        "optional": true
      },
      "debit": {
        "possible_names": ["Withdrawal Amount", "Withdrawal Amount (INR )", "Debit", "Dr", "Debit Amount"],
        "column_index": null,
        "data_type": "amount",
        "currency": "INR"
      },
      "credit": {
        "possible_names": ["Deposit Amount", "Deposit Amount (INR )", "Credit", "Cr", "Credit Amount"],
        "column_index": null,
        "data_type": "amount",
        "currency": "INR"
      },
      "balance": {
        "possible_names": ["Balance", "Balance (INR )", "Running Balance", "Available Balance"],
        "column_index": null,
        "data_type": "amount",
        "currency": "INR",
        "optional": true
      }
    }
  },
  
  "data_validation": {
    "required_columns": ["date", "description"],
    "amount_columns": ["debit", "credit"],
    "date_columns": ["date", "value_date"],
    
    "filters": {
      "exclude_rows_with": [
        "opening balance",
        "closing balance", 
        "brought forward",
        "carried forward",
        "total"
      ],
      "min_description_length": 3,
      "exclude_empty_descriptions": true
    }
  },
  
  "output_format": {
    "standard_columns": ["Date", "Description", "Reference", "Debit", "Credit", "Balance"],
    "date_output_format": "%d-%m-%Y",
    "amount_decimal_places": 2
  },
  
  "bank_specific": {
    "bank_name": "ICICI",
    "account_patterns": ["040001002821"],
    "statement_identifier_patterns": [
      "detailed statement",
      "transaction history",
      "account statement"
    ]
  },
  
  "examples": {
    "sample_header_row": {
      "row_number": 11,
      "columns": ["S No.", "Value Date", "Transaction Date", "Cheque Number", "Transaction Remarks", "Withdrawal Amount (INR )", "Deposit Amount (INR )", "Balance (INR )"]
    },
    "sample_data_row": {
      "row_number": 12,
      "columns": ["1", "01/01/25", "01/01/25", "-", "UPI/9871174569@ptsb/UPI/ICICI Bank/500101425785/ICI3a455d570ee24276a17b11dae935", "220.00", "0.0", "1130.35"]
    }
  },
  
  "custom_overrides": {
    "force_header_row": null,
    "force_data_start_row": null,
    "force_column_mapping": {},
    "custom_date_formats": [],
    "custom_amount_patterns": []
  }
}
